// js/systems/gaze-event.ts
// Kalgoth's Gaze - Deep, powerful daily survival event
// Fully integrated with tutorial system, fixed overlay dismissal and timer reset

import { batch } from '@preact/signals-core';
import {
  will,
  maxWill,
  health,
  kalgothsNoose,
  circlePower,
  circleMastery,
  orbexFragments,
  ingredients,
  crafted,
  runeSlots,
  equippedRelics,
  relicBonuses,
  familiar,
  addMasteryXP,
  addFamiliarXP,
  updateState,
  autoSave,
  gazeIntensity,
  wardIntegrities,
  gazeSurvivalCount,
  dailyConsumableSlots,
  isGazeActive,
  gazePhase,
  CONSTANTS,
  tutorial,
  timerSeconds,
  tithePaidThisDay
} from '../core/state-signals.js';
import { addLog } from '../ui/log-manager.js';
import { playSfx, startLoop, stopLoop } from '../audio/sfx.js';
import { showGazeUI, updateGazeUI, hideGazeUI } from '../ui/gaze-ui.js';
import { el } from '../core/dom-helper.js';
import { getRelicById } from '../data/relics.js';
import { applyWardNooseReduction } from './familiar-manager.js';
import { setGazeActive } from './day-cycle.js';

let gazeInterval: number | null = null;
let gazeTimerSeconds = 0;
let currentDrainRate = 0;
let lastUpdateTime = 0;
let consumableCooldowns: boolean[] = [false, false, false];
let warningTimeout: number | null = null;

export function startGazeWarning(): void {
  if (isGazeActive.value) return;
  
  if (warningTimeout) clearTimeout(warningTimeout);
  
  gazePhase.value = 'warning';
  isGazeActive.value = true;
  setGazeActive(true);
  
  const gameContainer = el('gameContainer');
  if (gameContainer) gameContainer.style.pointerEvents = 'none';
  
  showGazeUI('warning');
  
  addLog('⚠️ Whisp: "Kalgoth\'s eye turns this way! Return to the circle!"', true, 'whisp');
  playSfx('suspicionRise');
  startLoop('gazeWarningBg');
  
  warningTimeout = window.setTimeout(() => {
    startGazeEvent();
  }, 30000);
}

export function forceStartGazeEvent(): void {
  if (warningTimeout) {
    clearTimeout(warningTimeout);
    warningTimeout = null;
  }
  if (gazePhase.value === 'warning') {
    startGazeEvent();
  }
}

function startGazeEvent(): void {
  if (warningTimeout) { clearTimeout(warningTimeout); warningTimeout = null; }
  stopLoop('gazeWarningBg');
  gazePhase.value = 'active';
  
  if (wardIntegrities.value.length === 0 || wardIntegrities.value.every(v => v === 100)) {
    wardIntegrities.value = [
      CONSTANTS.WARD_BASE_INTEGRITY,
      CONSTANTS.WARD_BASE_INTEGRITY,
      CONSTANTS.WARD_BASE_INTEGRITY
    ];
  }
  
  currentDrainRate = calculateDrainRate();
  gazeTimerSeconds = CONSTANTS.GAZE_DURATION_SECONDS;
  lastUpdateTime = performance.now();
  consumableCooldowns = [false, false, false];
  
  showGazeUI('active');
  startLoop('gazeEventBg');
  playSfx('demonSummonBg');
  
  addLog('🔥 The Gaze engulfs you! Hold the circle!', true, 'orbex');
  
  gazeInterval = window.setInterval(() => {
    updateGazeTick();
  }, 100);
}

function calculateDrainRate(): number {
  let baseRate = CONSTANTS.GAZE_BASE_DRAIN_RATE + (gazeIntensity.value * CONSTANTS.GAZE_DRAIN_PER_INTENSITY);
  
  const relics = relicBonuses.value;
  if (relics.suspicionReduction) {
    baseRate *= (1 - relics.suspicionReduction / 100);
  }
  
  baseRate *= (1 - orbexFragments.value * 0.05);
  
  const avgIntegrity = wardIntegrities.value.reduce((a, b) => a + b, 0) / 3;
  const wardPenalty = 1 + (1 - avgIntegrity / 100) * 0.5;
  baseRate *= wardPenalty;
  
  baseRate *= (1 - circlePower.value / 200);
  
  return Math.max(1, baseRate);
}

function updateGazeTick(): void {
  if (!isGazeActive.value || gazePhase.value !== 'active') return;
  
  const now = performance.now();
  const deltaSeconds = (now - lastUpdateTime) / 1000;
  lastUpdateTime = now;
  
  const drainAmount = currentDrainRate * deltaSeconds;
  will.value = Math.max(0, will.value - drainAmount);
  
  const wardDamage = drainAmount * 2;
  for (let i = 0; i < 3; i++) {
    if (runeSlots.value[i] && wardIntegrities.value[i] > 0) {
      wardIntegrities.value[i] = Math.max(0, wardIntegrities.value[i] - wardDamage);
    }
  }
  wardIntegrities.value = [...wardIntegrities.value];
  
  currentDrainRate = calculateDrainRate();
  gazeTimerSeconds -= deltaSeconds;
  
  updateGazeUI({
    willPercent: will.value / maxWill.value,
    timerSeconds: Math.max(0, gazeTimerSeconds),
    drainRate: currentDrainRate,
    wardIntegrities: wardIntegrities.value
  });
  
  for (let i = 0; i < 3; i++) {
    if (wardIntegrities.value[i] <= 0 && runeSlots.value[i]) {
      addLog(`💔 Ward ${i + 1} shatters!`, true);
      wardIntegrities.value[i] = 0;
      playSfx('runeEtchFail');
    }
  }
  
  if (will.value <= 0) {
    endGazeEvent(false);
  } else if (gazeTimerSeconds <= 0) {
    endGazeEvent(true);
  }
}

export function useConsumable(slotIndex: number): boolean {
  if (!isGazeActive.value || gazePhase.value !== 'active') return false;
  if (consumableCooldowns[slotIndex]) return false;
  
  const slotId = dailyConsumableSlots.value[slotIndex];
  if (!slotId) return false;
  
  let success = false;
  
  if (slotId === 'restorativeDraught' && crafted.value.restorativeDraught > 0) {
    crafted.value.restorativeDraught--;
    will.value = Math.min(maxWill.value, will.value + 30);
    addLog('You drink a Restorative Draught. Will restored!', false, 'player');
    playSfx('useHealingRestore');
    success = true;
  } else if (slotId === 'powderOfWarding' && crafted.value.powderOfWarding > 0) {
    crafted.value.powderOfWarding--;
    for (let i = 0; i < 3; i++) {
      wardIntegrities.value[i] = Math.min(100, wardIntegrities.value[i] + 30);
    }
    wardIntegrities.value = [...wardIntegrities.value];
    addLog('You apply Powder of Warding. Wards repaired!', false, 'player');
    playSfx('powderSuccess');
    success = true;
  } else if (slotId === 'phialOfSubjugation' && crafted.value.phialOfSubjugation > 0) {
    crafted.value.phialOfSubjugation--;
    currentDrainRate *= 0.5;
    setTimeout(() => {
      currentDrainRate = calculateDrainRate();
    }, 10000);
    addLog('You shatter a Phial. The Gaze weakens!', false, 'player');
    playSfx('phialSuccess');
    success = true;
  }
  
  if (success) {
    consumableCooldowns[slotIndex] = true;
    setTimeout(() => {
      consumableCooldowns[slotIndex] = false;
    }, 1000);
    return true;
  }
  
  addLog('No consumable available!', true);
  return false;
}

export function reinforceWard(wardIndex: number): boolean {
  if (!isGazeActive.value || gazePhase.value !== 'active') return false;
  if (!runeSlots.value[wardIndex]) return false;
  if (wardIntegrities.value[wardIndex] <= 0) return false;
  if (ingredients.value.nightshadeMoss < 1 || ingredients.value.cryptPhlegm < 1) {
    addLog('Not enough Moss or Phlegm!', true);
    return false;
  }
  
  ingredients.value.nightshadeMoss--;
  ingredients.value.cryptPhlegm--;
  
  const repairAmount = 15 + circleMastery.value * 2;
  wardIntegrities.value[wardIndex] = Math.min(100, wardIntegrities.value[wardIndex] + repairAmount);
  wardIntegrities.value = [...wardIntegrities.value];
  
  addLog(`Ward ${wardIndex + 1} reinforced!`, false, 'player');
  playSfx('runeApply');
  return true;
}

function endGazeEvent(survived: boolean): void {
  if (warningTimeout) { clearTimeout(warningTimeout); warningTimeout = null; }
  if (gazeInterval) {
    clearInterval(gazeInterval);
    gazeInterval = null;
  }
  
  stopLoop('gazeEventBg');
  isGazeActive.value = false;
  gazePhase.value = 'inactive';
  setGazeActive(false);
  
  const gameContainer = el('gameContainer');
  if (gameContainer) gameContainer.style.pointerEvents = 'auto';
  
  hideGazeUI();
  
  if (survived) {
    const baseIchor = 5 + Math.floor(gazeIntensity.value / 2);
    const masteryXP = 25 + gazeIntensity.value * 2;
    const familiarXP = 10 + gazeIntensity.value;
    
    batch(() => {
      ingredients.value.demonIchor += baseIchor;
      gazeSurvivalCount.value++;
      const nooseReduction = applyWardNooseReduction(20);
      kalgothsNoose.value = Math.max(0, kalgothsNoose.value - nooseReduction);
    });
    
    addMasteryXP(masteryXP);
    addFamiliarXP(familiarXP);
    
    addLog(`✨ You survived the Gaze! +${baseIchor} Ichor, +${masteryXP} Mastery XP`, false, 'orbex');
    playSfx('gameWin');
    
    if (gazeSurvivalCount.value === 1) {
      tutorial.value = { ...tutorial.value, firstGazeSurvived: true, guidedFirstDayComplete: true };
      addLog('Whisp: "You have endured. The tutorial is complete. I will offer hints when needed."', false, 'whisp');
    }
    
    if (Math.random() < 0.1 + gazeIntensity.value * 0.01) {
      addLog('🌟 A relic fragment materializes from the Gaze!', false, 'player');
    }
  } else {
    addLog('💀 The Gaze overwhelms you...', true);
    playSfx('gameOver');
    
    if (orbexFragments.value > 0) {
      orbexFragments.value--;
      health.value = 50;
      will.value = maxWill.value;
      addLog('You awaken, but a fragment is lost...', true);
    } else {
      alert('GAME OVER - Kalgoth claims your soul.');
      document.body.style.pointerEvents = 'none';
      return;
    }
  }
  
  timerSeconds.value = 600;
  tithePaidThisDay.value = false;
  autoSave();
}

export function getCurrentGazeIntensity(): number {
  return gazeIntensity.value;
}

export function setGazeIntensity(intensity: number): void {
  gazeIntensity.value = Math.min(100, Math.max(0, intensity));
}

export function isGazeEventActive(): boolean {
  return isGazeActive.value;
}