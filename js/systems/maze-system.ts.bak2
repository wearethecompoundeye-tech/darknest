// js/systems/maze-system.ts
// Node-based Undercrypt expedition with Kalgoth's Gaze intensity scaling

import { batch } from '@preact/signals-core';
import {
  state,
  activeDemon,
  orbexFragments,
  maxOrbexFragments,
  ingredients,
  seedResonance,
  maxSeedResonance,
  totalExplorations,
  mazePathsUnlocked,
  discoveries,
  updateState,
  addFamiliarXP,
  addMasteryXP,
  autoSave,
  discover,
  useSeedResonance,
  kalgothsNoose,
  circlePower,
  circleMastery,
  getEquippedCards,
  getActiveEntity,
  addCard,
  ownedCards,
  gazeIntensity,
  gazeSurvivalCount,
  type Card,
  type EntityStats
} from '../core/state-signals.js';
import { getCardById, type Card, type EntityStats } from '../data/cards.js';
import { addLog } from '../ui/log-manager.js';
import { addLedgerEntry } from '../ui/ledger.js';
import { playSfx, startLoop, stopLoop } from '../audio/sfx.js';
import { openWillDuel, type WillDuelConfig } from '../ui/will-duel.js';
import { openCardBattleModal } from '../ui/card-battle.js';
import { startPhialBrewing } from '../minigames/phial-brew.js';
import { el } from '../core/dom-helper.js';
import { allCards } from '../data/cards.js';
import { getEchoReward, getHollowReward } from './card-acquisition.js';
import { getEnhancedStats, checkForCombos, getAspectSynergyBonus } from './card-progression.js';

// Expedition state
let expeditionActive = false;
let expeditionMap: MazeNode[][] = [];
let currentPosition: { x: number; y: number } = { x: 0, y: 0 };
let exploredTiles: boolean[][] = [];
let expeditionLog: string[] = [];
let selectedPathId: string = 'Warded';
let activeEntityCard: Card | null = null;
let entityCurrentHP: number = 0;
let entityMaxHP: number = 0;
let movesRemaining: number = 0;
let handSpells: Card[] = [];

export let unlockOrbexBoon: (() => void) | null = null;

const GRID_SIZE = 8;

enum NodeType {
  EMPTY = 'empty',
  RESOURCE = 'resource',
  WARD = 'ward',
  TRAP = 'trap',
  MINION = 'minion',
  ECHO = 'echo',
  HOLLOW_LAIR = 'hollow_lair',
  EXIT = 'exit',
  ENTRANCE = 'entrance'
}

interface MazeNode {
  type: NodeType;
  discovered: boolean;
  explored: boolean;
  resourceType?: string;
  resourceAmount?: number;
  wardDifficulty?: number;
  trapDifficulty?: number;
  minionPower?: number;
  echoCardId?: string;
  hollowFragmentIndex?: number;
}

// Path configurations - base values
const BASE_PATH_CONFIGS: Record<string, PathConfig> = {
  'Warded': {
    name: 'Warded Corridor',
    desc: 'Many wards, moderate danger.',
    icon: '/Images/Game Art/Maze/Path_Warded.png',
    wardChance: 0.3, trapChance: 0.15, minionChance: 0.15,
    resourceChance: 0.25, echoChance: 0.1, hollowChance: 0.05
  },
  'Collapsed': {
    name: 'Collapsed Tunnel',
    desc: 'Treacherous, but higher fragment chance.',
    icon: '/Images/Game Art/Maze/Path_Collapsed.png',
    wardChance: 0.2, trapChance: 0.35, minionChance: 0.2,
    resourceChance: 0.15, echoChance: 0.05, hollowChance: 0.05
  },
  'Echoing': {
    name: 'Echoing Hall',
    desc: 'Balanced, good for finding echoes.',
    icon: '/Images/Game Art/Maze/Path_Echoing.png',
    wardChance: 0.2, trapChance: 0.2, minionChance: 0.15,
    resourceChance: 0.2, echoChance: 0.2, hollowChance: 0.05
  },
  'Safe': {
    name: 'Safe Passage',
    desc: 'Low danger, fewer rewards.',
    icon: '/Images/Game Art/Maze/Path_Safe.png',
    wardChance: 0.1, trapChance: 0.1, minionChance: 0.1,
    resourceChance: 0.4, echoChance: 0.15, hollowChance: 0.15
  }
};

interface PathConfig {
  name: string;
  desc: string;
  icon: string;
  wardChance: number;
  trapChance: number;
  minionChance: number;
  resourceChance: number;
  echoChance: number;
  hollowChance: number;
}

// Apply Gaze intensity scaling to path config
function getScaledPathConfig(pathId: string): PathConfig {
  const base = BASE_PATH_CONFIGS[pathId] || BASE_PATH_CONFIGS['Warded'];
  const intensity = gazeIntensity.value;
  const scale = 1 + intensity / 100; // up to 2x difficulty at max intensity
  
  return {
    ...base,
    wardChance: Math.min(0.6, base.wardChance * scale),
    trapChance: Math.min(0.5, base.trapChance * scale),
    minionChance: Math.min(0.4, base.minionChance * scale),
    resourceChance: base.resourceChance * (1 + intensity / 200), // rewards also scale
    echoChance: base.echoChance * (1 + intensity / 150),
    hollowChance: base.hollowChance // hollow lairs remain fixed, but difficulty scales
  };
}

// Get difficulty modifier based on Gaze intensity and distance from entrance
function getDifficultyModifier(x: number, y: number): number {
  const distance = Math.sqrt(x*x + y*y) / GRID_SIZE; // 0 to ~1.4
  return 1 + (gazeIntensity.value / 100) + distance * 0.5;
}

function generateMaze(pathId: string): MazeNode[][] {
  const grid: MazeNode[][] = Array(GRID_SIZE).fill(null).map(() => Array(GRID_SIZE).fill(null));
  const config = getScaledPathConfig(pathId);
  
  for (let i = 0; i < GRID_SIZE; i++) {
    for (let j = 0; j < GRID_SIZE; j++) {
      grid[i][j] = { type: NodeType.EMPTY, discovered: false, explored: false };
    }
  }
  
  grid[0][0] = { type: NodeType.ENTRANCE, discovered: true, explored: true };
  
  const fragmentsNeeded = maxOrbexFragments.value - orbexFragments.value;
  for (let f = 0; f < Math.min(fragmentsNeeded, 3); f++) {
    let placed = false;
    for (let attempts = 0; attempts < 50 && !placed; attempts++) {
      const x = Math.floor(Math.random() * (GRID_SIZE - 2)) + 1;
      const y = Math.floor(Math.random() * (GRID_SIZE - 2)) + 1;
      if (grid[x][y].type === NodeType.EMPTY) {
        grid[x][y] = {
          type: NodeType.HOLLOW_LAIR,
          discovered: false,
          explored: false,
          hollowFragmentIndex: orbexFragments.value + f + 1
        };
        placed = true;
      }
    }
  }
  
  for (let i = 0; i < GRID_SIZE; i++) {
    for (let j = 0; j < GRID_SIZE; j++) {
      if ((i === 0 && j === 0) || grid[i][j].type !== NodeType.EMPTY) continue;
      
      const roll = Math.random();
      let cum = 0;
      const mod = getDifficultyModifier(i, j);
      
      if (roll < (cum += config.wardChance)) {
        grid[i][j] = {
          type: NodeType.WARD,
          discovered: false,
          explored: false,
          wardDifficulty: Math.floor((10 + Math.random() * 8) * mod)
        };
      } else if (roll < (cum += config.trapChance)) {
        grid[i][j] = {
          type: NodeType.TRAP,
          discovered: false,
          explored: false,
          trapDifficulty: Math.floor((12 + Math.random() * 6) * mod)
        };
      } else if (roll < (cum += config.minionChance)) {
        grid[i][j] = {
          type: NodeType.MINION,
          discovered: false,
          explored: false,
          minionPower: Math.floor((8 + Math.random() * 10) * mod)
        };
      } else if (roll < (cum += config.resourceChance)) {
        const resources = ['nightshadeMoss', 'cryptPhlegm', 'demonIchor', 'boneDust'];
        grid[i][j] = {
          type: NodeType.RESOURCE,
          discovered: false,
          explored: false,
          resourceType: resources[Math.floor(Math.random() * resources.length)],
          resourceAmount: Math.floor((2 + Math.random() * 5) * (1 + gazeIntensity.value / 200))
        };
      } else if (roll < (cum += config.echoChance)) {
        const echoCards = allCards.filter(c => c.type === 'spell' || c.type === 'enhancement');
        const card = echoCards[Math.floor(Math.random() * echoCards.length)];
        grid[i][j] = {
          type: NodeType.ECHO,
          discovered: false,
          explored: false,
          echoCardId: card?.id
        };
      }
    }
  }
  
  grid[GRID_SIZE-1][GRID_SIZE-1] = { type: NodeType.EXIT, discovered: false, explored: false };
  return grid;
}

function renderExpeditionUI(): void {
  const container = el('expeditionGridContainer');
  if (!container) return;
  
  const config = getScaledPathConfig(selectedPathId);
  const intensity = gazeIntensity.value;
  const corruptionClass = intensity > 60 ? 'maze-corruption-high' : (intensity > 30 ? 'maze-corruption-mid' : 'maze-corruption-low');
  
  let html = `<div style="display:flex; gap:20px;" class="${corruptionClass}">
    <div>
      <h4 style="display:flex; align-items:center; gap:10px;">
        <img src="${config.icon}" style="width:32px; height:32px;">
        <span>${config.name}</span>
        <span style="font-size:0.7rem; color:${intensity > 50 ? '#ff6a6a' : '#a0d07a'};">Gaze: ${intensity}%</span>
      </h4>
      <div style="display:grid; grid-template-columns:repeat(${GRID_SIZE},70px); gap:4px; margin:15px 0;">`;
  
  for (let i = 0; i < GRID_SIZE; i++) {
    for (let j = 0; j < GRID_SIZE; j++) {
      const node = expeditionMap[i][j];
      const isCurrent = (i === currentPosition.x && j === currentPosition.y);
      const isDiscovered = node.discovered;
      const isAdjacent = !isCurrent && Math.abs(i - currentPosition.x) + Math.abs(j - currentPosition.y) === 1 && movesRemaining > 0;
      
      let bg = '#1a100a';
      let content = '';
      let cursor = 'default';
      let extraClass = '';
      
      if (!isDiscovered) {
        bg = '#0a0508'; content = '?';
      } else if (isCurrent) {
        bg = '#3a6a3a'; content = '🜁';
      } else {
        switch (node.type) {
          case NodeType.EMPTY: bg = '#2a2a2a'; content = '·'; break;
          case NodeType.ENTRANCE: bg = '#4a6a4a'; content = '🚪'; break;
          case NodeType.EXIT: bg = '#6a4a2a'; content = '⬆️'; break;
          case NodeType.RESOURCE: bg = '#2a6a2a'; content = '💎'; break;
          case NodeType.WARD: bg = '#4a2a6a'; content = 'ᚠ'; break;
          case NodeType.TRAP: bg = '#8a2a2a'; content = '⚠️'; break;
          case NodeType.MINION: bg = '#6a2a2a'; content = '👹'; break;
          case NodeType.ECHO: bg = '#4a6a8a'; content = '🌀'; break;
          case NodeType.HOLLOW_LAIR: bg = '#6a2a4a'; content = '💀'; break;
        }
      }
      
      // Apply corruption visual based on intensity and distance
      const distanceFactor = Math.sqrt(i*i + j*j) / GRID_SIZE;
      const corruptionAlpha = Math.min(0.6, (intensity / 100) * distanceFactor);
      if (isDiscovered && intensity > 0) {
        extraClass = `tile-corruption-${Math.floor(corruptionAlpha * 10)}`;
      }
      
      if (isAdjacent) cursor = 'pointer';
      
      html += `<div data-x="${i}" data-y="${j}" class="maze-node ${extraClass}" style="width:70px; height:70px; background:${bg}; border:1px solid #5a4a3a; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:20px; cursor:${cursor}; transition:all 0.15s; ${isCurrent ? 'box-shadow:0 0 15px #3a6a3a;' : ''}">${content}</div>`;
    }
  }
  
  html += `</div>
      <div style="display:flex; gap:10px; margin-top:10px;">
        <button id="expeditionRecallBtn" class="craft-btn" style="background:#5a2a2a;">🚨 Recall</button>
        <button id="expeditionRestBtn" class="craft-btn" ${movesRemaining > 0 ? 'disabled' : ''}>💤 Rest</button>
      </div>
    </div>
    <div style="min-width:220px;">
      <h4>🜁 ${activeEntityCard?.name || 'Entity'}</h4>
      <div class="stat-row"><span>❤️ Health</span><span>${entityCurrentHP}/${entityMaxHP}</span></div>
      <div class="progress-bar"><div class="progress-fill" style="width:${(entityCurrentHP/entityMaxHP)*100}%;"></div></div>
      <div class="stat-row"><span>👟 Moves</span><span>${movesRemaining}</span></div>
      <div class="stat-row"><span>🦊 Cunning</span><span>${(activeEntityCard?.stats as EntityStats)?.cun || 0}</span></div>
      <div class="stat-row"><span>⚔️ Attack</span><span>${(activeEntityCard?.stats as EntityStats)?.atk || 0}</span></div>
      <div style="margin-top:15px; max-height:200px; overflow-y:auto; font-size:0.8rem;" id="expeditionLog">${expeditionLog.map(l => `<div>> ${l}</div>`).join('')}</div>
    </div>
  </div>`;
  
  container.innerHTML = html;
  
  container.querySelectorAll('[data-x]').forEach(el => {
    el.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const x = parseInt(target.dataset.x!);
      const y = parseInt(target.dataset.y!);
      if (Math.abs(x - currentPosition.x) + Math.abs(y - currentPosition.y) === 1 && movesRemaining > 0) {
        handleMove(x, y);
      }
    });
  });
  
  const recallBtn = el('expeditionRecallBtn');
  if (recallBtn) recallBtn.addEventListener('click', () => endExpedition(true));
  const restBtn = el('expeditionRestBtn');
  if (restBtn) restBtn.addEventListener('click', handleRest);
}

function handleRest(): void {
  if (movesRemaining > 0) return;
  const spd = (activeEntityCard?.stats as EntityStats)?.spd || 3;
  movesRemaining = spd;
  expeditionLog.push(`Entity rests and recovers ${spd} moves.`);
  renderExpeditionUI();
}

function handleMove(x: number, y: number): void {
  if (!expeditionActive) return;
  currentPosition = { x, y };
  movesRemaining--;
  const node = expeditionMap[x][y];
  
  if (!node.discovered) {
    node.discovered = true;
    revealAdjacentTiles(x, y);
    
    switch (node.type) {
      case NodeType.EMPTY: expeditionLog.push(`Moved to an empty chamber.`); renderExpeditionUI(); break;
      case NodeType.RESOURCE: handleResourceNode(node); break;
      case NodeType.WARD: handleWardNode(node); break;
      case NodeType.TRAP: handleTrapNode(node); break;
      case NodeType.MINION: handleMinionNode(node); break;
      case NodeType.ECHO: handleEchoNode(node); break;
      case NodeType.HOLLOW_LAIR: handleHollowNode(node); break;
      case NodeType.EXIT: expeditionLog.push(`Found the exit!`); endExpedition(true); break;
      default: renderExpeditionUI();
    }
  } else {
    expeditionLog.push(`Moved to a known area.`);
    renderExpeditionUI();
  }
  
  if (movesRemaining <= 0) {
    expeditionLog.push(`Entity is exhausted.`);
    renderExpeditionUI();
  }
}

function revealAdjacentTiles(x: number, y: number): void {
  for (let dx = -1; dx <= 1; dx++) {
    for (let dy = -1; dy <= 1; dy++) {
      if (Math.abs(dx) + Math.abs(dy) !== 1) continue;
      const nx = x + dx, ny = y + dy;
      if (nx >= 0 && nx < GRID_SIZE && ny >= 0 && ny < GRID_SIZE) {
        expeditionMap[nx][ny].discovered = true;
      }
    }
  }
}

function handleResourceNode(node: MazeNode): void {
  const ing = node.resourceType!;
  let amt = node.resourceAmount!;
  // Bonus for high intensity
  amt = Math.floor(amt * (1 + gazeIntensity.value / 200));
  ingredients.value = { ...ingredients.value, [ing]: (ingredients.value[ing as keyof typeof ingredients.value] || 0) + amt };
  discover('ingredients', ing);
  expeditionLog.push(`Found ${amt}x ${ing}!`);
  renderExpeditionUI();
}

function handleWardNode(node: MazeNode): void {
  if (!expeditionActive) return;
  const modal = el('expeditionModal');
  if (modal) modal.style.display = 'none';
  startPhialBrewing((success, completedRounds) => {
    if (modal) modal.style.display = 'flex';
    if (success && completedRounds >= 1) {
      expeditionLog.push(`Ward bypassed!`);
      node.explored = true;
      renderExpeditionUI();
    } else {
      const damage = Math.floor(5 + (node.wardDifficulty || 10) / 3);
      entityCurrentHP -= damage;
      expeditionLog.push(`Ward repels! -${damage} HP.`);
      if (entityCurrentHP <= 0) { expeditionLog.push(`${activeEntityCard?.name} banished!`); endExpedition(false); }
      else renderExpeditionUI();
    }
  });
}

function handleTrapNode(node: MazeNode): void {
  const baseStats = (activeEntityCard?.stats as EntityStats) || { cun: 0 } as EntityStats;
  const enhancedStats = activeEntityCard ? getEnhancedStats(activeEntityCard.id) || baseStats : baseStats;
  const synergyBonus = getAspectSynergyBonus();
  const cun = enhancedStats.cun + (synergyBonus.cun || 0);
  const difficulty = node.trapDifficulty || 12;
  const roll = Math.floor(Math.random() * 20) + cun;
  if (roll >= difficulty) {
    expeditionLog.push(`Trap disarmed.`);
  } else {
    const damage = Math.floor(8 - cun / 2);
    entityCurrentHP -= Math.max(2, damage);
    expeditionLog.push(`Trap triggered! -${Math.max(2, damage)} HP.`);
  }
  if (entityCurrentHP <= 0) { expeditionLog.push(`${activeEntityCard?.name} perished!`); endExpedition(false); }
  else renderExpeditionUI();
}

function handleMinionNode(node: MazeNode): void {
  const minionPower = node.minionPower || 10;
  const minionCard: Card = {
    id: 'minion', name: 'Kalgoth\'s Minion', type: 'entity', rarity: 'common', aspect: 'Void',
    image: '/Images/Game Art/Creatures/Umbral Mite.png', frame: '/Images/Game Art/Frame Overlays/Common Frame.png',
    stats: { hp: minionPower, atk: 3 + Math.floor(gazeIntensity.value/20), spd: 0, cun: 0, def: 0, res: 0, init: 2, loyalty: 100 }
  };
  const playerCard = activeEntityCard;
  const enhancedPlayerCard = playerCard ? { ...playerCard, stats: getEnhancedStats(playerCard.id) || playerCard.stats } : undefined;
  openCardBattleModal({
    enemyCard: minionCard, playerCard: enhancedPlayerCard, advantage: 0, isMazeMinion: true,
    onVictory: () => {
      const ichor = Math.floor((2 + Math.random() * 4) * (1 + gazeIntensity.value/100));
      ingredients.value = { ...ingredients.value, demonIchor: ingredients.value.demonIchor + ichor };
      expeditionLog.push(`Minion defeated! +${ichor} Ichor.`);
      renderExpeditionUI();
    },
    onDefeat: () => { entityCurrentHP = 0; expeditionLog.push(`${activeEntityCard?.name} was defeated!`); endExpedition(false); },
    onFlee: () => { expeditionLog.push(`Fled from minion.`); renderExpeditionUI(); }
  });
}

function handleEchoNode(node: MazeNode): void {
  const rewardCard = getEchoReward(selectedPathId);
  addCard(rewardCard.id, 1);
  expeditionLog.push(`Echo reveals ${rewardCard.name} (${rewardCard.rarity})!`);
  renderExpeditionUI();
}

function handleHollowNode(node: MazeNode): void {
  const fragmentIndex = node.hollowFragmentIndex || orbexFragments.value + 1;
  openWillDuel({
    hollowName: `Hollow Acolyte (Fragment ${fragmentIndex})`,
    hollowPortrait: '/Images/Hollow_Portrait.png',
    fragmentIndex,
    baseResistance: 15 + fragmentIndex * 3 + Math.floor(gazeIntensity.value / 10),
    onVictory: () => {
      orbexFragments.value = Math.min(maxOrbexFragments.value, orbexFragments.value + 1);
      // Increase Gaze intensity as player moves inward
      gazeIntensity.value = Math.min(100, gazeIntensity.value + 15);
      expeditionLog.push(`Hollow purified! Fragment ${orbexFragments.value}/${maxOrbexFragments.value} reclaimed. Gaze intensifies...`);
      const rewardCard = getHollowReward(fragmentIndex);
      addCard(rewardCard.id, 1);
      expeditionLog.push(`Gained ${rewardCard.name} (${rewardCard.rarity}).`);
      renderExpeditionUI();
    },
    onDefeat: () => { expeditionLog.push(`Hollow escapes.`); renderExpeditionUI(); }
  });
}

function endExpedition(success: boolean): void {
  expeditionActive = false;
  stopLoop('demonSummonBg');
  const modal = el('expeditionModal');
  if (modal) modal.style.display = 'none';
  if (success) {
    addLog(`${activeEntityCard?.name} returns from the Undercrypt.`, false, 'player');
    addFamiliarXP(10 + Math.floor(gazeIntensity.value/10));
    addMasteryXP(15 + Math.floor(gazeIntensity.value/5));
    addLedgerEntry('explore', { success: true, path: selectedPathId });
  } else {
    addLog(`${activeEntityCard?.name} was lost in the Undercrypt.`, true);
  }
  totalExplorations.value++;
  autoSave();
}

export function startExpedition(entityCardId: string, pathId: string): void {
  const card = getCardById(entityCardId);
  if (!card || card.type !== 'entity') { addLog('Invalid entity selected.', true); return; }
  activeEntityCard = card;
  selectedPathId = pathId;
  expeditionMap = generateMaze(pathId);
  currentPosition = { x: 0, y: 0 };
  const baseStats = card.stats as EntityStats;
  const enhancedStats = getEnhancedStats(card.id) || baseStats;
  const synergyBonus = getAspectSynergyBonus();
  entityMaxHP = enhancedStats.hp + (synergyBonus.hp || 0);
  entityCurrentHP = entityMaxHP;
  movesRemaining = enhancedStats.spd + (synergyBonus.spd || 0);
  const combos = checkForCombos();
  if (combos.length > 0) combos.forEach(c => expeditionLog.push(`✨ Combo: ${c.effect}`));
  handSpells = getEquippedCards('spell').slice(0, 3);
  expeditionLog = [`${card.name} enters the ${getScaledPathConfig(pathId).name}. Gaze intensity: ${gazeIntensity.value}%`];
  expeditionActive = true;
  const modal = el('expeditionModal');
  if (modal) { modal.style.display = 'flex'; renderExpeditionUI(); }
  playSfx('Maze_Send');
  startLoop('demonSummonBg');
  addLog(`${card.name} begins expedition.`, false, 'player');
}

export function showPathSelectionModal(): void {
  const equippedEntities = getEquippedCards('entity');
  if (equippedEntities.length === 0) { addLog('No entities equipped.', true); return; }
  const overlay = document.createElement('div');
  overlay.className = 'modal';
  overlay.style.display = 'flex';
  overlay.style.zIndex = '2500';
  let entitiesHtml = '';
  equippedEntities.forEach(card => {
    const stats = card.stats as EntityStats;
    entitiesHtml += `<div class="entity-option" data-entity-id="${card.id}" style="display:flex; align-items:center; gap:15px; background:rgba(20,5,20,0.9); border:1px solid #5a4a3a; border-radius:12px; padding:15px; margin:10px 0; cursor:pointer;"><img src="${card.image}" style="width:60px; height:80px; object-fit:cover; border-radius:8px;"><div><h4 style="margin:0 0 5px; color:#d4af37;">${card.name}</h4><p style="margin:0; font-size:0.8rem;">❤️ ${stats.hp} | ⚔️ ${stats.atk} | 👟 ${stats.spd} | 🦊 ${stats.cun}</p></div></div>`;
  });
  let pathsHtml = '';
  Object.entries(BASE_PATH_CONFIGS).forEach(([id, config]) => {
    if (!mazePathsUnlocked.value.includes(id)) return;
    const scaled = getScaledPathConfig(id);
    pathsHtml += `<div class="path-option" data-path="${id}" style="display:flex; align-items:center; gap:15px; background:rgba(20,5,20,0.9); border:1px solid #5a4a3a; border-radius:12px; padding:15px; margin:10px 0; cursor:pointer;"><img src="${config.icon}" style="width:50px; height:50px;"><div><h4 style="margin:0 0 5px; color:#d4af37;">${config.name}</h4><p style="margin:0; font-size:0.8rem;">${config.desc}<br>Gaze scaling: ${Math.floor(scaled.wardChance*100)}% wards</p></div></div>`;
  });
  overlay.innerHTML = `<div class="modal-content" style="max-width:600px;"><h3>🗺️ Choose Entity</h3>${entitiesHtml}<h3 style="margin-top:20px;">Choose Path</h3>${pathsHtml}<button id="cancelPathBtn" class="craft-btn">Cancel</button></div>`;
  document.body.appendChild(overlay);
  let selectedEntityId: string | null = null;
  overlay.querySelectorAll('.entity-option').forEach(el => { el.addEventListener('click', () => { overlay.querySelectorAll('.entity-option').forEach(e => e.style.border = '1px solid #5a4a3a'); (el as HTMLElement).style.border = '2px solid #d4af37'; selectedEntityId = (el as HTMLElement).dataset.entityId!; }); });
  overlay.querySelectorAll('.path-option').forEach(el => { el.addEventListener('click', () => { if (!selectedEntityId) { addLog('Select an entity first.', true); return; } const pathId = (el as HTMLElement).dataset.path!; overlay.remove(); startExpedition(selectedEntityId, pathId); }); });
  overlay.querySelector('#cancelPathBtn')!.addEventListener('click', () => overlay.remove());
}

export function setUnlockBoonCallback(cb: () => void): void { unlockOrbexBoon = cb; }
export function closeMazeModal(): void { const modal = el('mazeModal'); if (modal) modal.style.display = 'none'; }