// FIXED: Properly clear activeDemon when releasing captured demon
export function releaseCapturedDemon(index: number): void {
  if (index < 0 || index >= capturedDemons.value.length) {
    addLog("Invalid demon index.", true);
    return;
  }
  
  const demon = capturedDemons.value[index];
  const demonCard = allCards.find(c => c.name === demon.name || c.id === demon.name);
  
  if (demonCard) {
    // Remove from owned cards if present
    if (hasCard(demonCard.id)) {
      removeCard(demonCard.id, 1);
    }
    // Remove from equipped slots
    unequipCardIfPresent(demonCard.id);
  }
  
  // Clear activeDemon if it matches this demon
  if (activeDemon.value?.name === demon.name) {
    activeDemon.value = null;
  }
  
  capturedDemons.value = capturedDemons.value.filter((_, i) => i !== index);
  releasedDemons.value = [...releasedDemons.value, demon.trait];
  
  addLog(`${demon.name} has been released.`, false, 'player');
  playSfx('releaseDemon');
  autoSave();
}

// Helper to unequip card from all slots
function unequipCardIfPresent(cardId: string): void {
  equippedEntitySlots.value = equippedEntitySlots.value.filter(id => id !== cardId);
  // Also check other slot types if needed
}

function hasCard(cardId: string): boolean {
  return ownedCards.value.some(c => c.cardId === cardId);
}

function removeCard(cardId: string, quantity: number = 1): boolean {
  const current = ownedCards.value;
  const index = current.findIndex(c => c.cardId === cardId);
  if (index === -1) return false;
  const card = current[index];
  if (card.quantity <= quantity) {
    ownedCards.value = current.filter((_, i) => i !== index);
  } else {
    card.quantity -= quantity;
    ownedCards.value = [...current];
  }
  return true;
}

export function collectAsh(): void {
  if (!ashAvailable.value || !pendingAshRemains.value) {
    addLog("No ashes.", true);
    return;
  }
  const reward = (pendingAshRemains.value as any)?.reward || {};
  for (const key in reward) {
    ingredients.value = { ...ingredients.value, [key]: (ingredients.value[key as keyof typeof ingredients.value] || 0) + reward[key] };
    discover('ingredients', key);
  }
  addLog(`Ash collected.`, false, 'player');
  playSfx('ashPile');
  ashAvailable.value = false;
  pendingAshRemains.value = null;
  const ashArea = el("ashPileArea");
  if (ashArea) ashArea.style.display = "none";
}