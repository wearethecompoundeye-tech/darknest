// Map old demon traits to new aspects for compatibility
const traitToAspect: Record<DemonTrait, string> = {
  'Imp': 'Void',
  'Cunning': 'Air',
  'Feral': 'Fire',
  'Ancient': 'Earth',
  'Volatile': 'Fire',
  'Shadow-touched': 'Void'
};

// Entity tiers and summoning difficulty
const SUMMON_TIERS = {
  1: { baseDifficulty: 8, healthCost: 5 },
  2: { baseDifficulty: 14, healthCost: 10 },
  3: { baseDifficulty: 20, healthCost: 20 }
} as const;

// Select a random entity card based on aspect and tier
function getRandomEntityCard(aspect: string, tier: 1 | 2 | 3): Card | undefined {
  const entityCards = allCards.filter(c => 
    c.type === 'entity' && 
    (c.aspect === aspect || c.aspect === 'All') &&
    ((tier === 1 && c.rarity === 'common') ||
     (tier === 2 && (c.rarity === 'uncommon' || c.rarity === 'rare')) ||
     (tier === 3 && (c.rarity === 'epic' || c.rarity === 'legendary')))
  );
  if (entityCards.length === 0) {
    return allCards.find(c => c.type === 'entity' && c.rarity === 'common');
  }
  return entityCards[Math.floor(Math.random() * entityCards.length)];
}

// Calculate summon success chance (used as advantage in card battle)
function calculateSummonAdvantage(entityCard: Card): number {
  const bonuses = getRuneBonuses();
  const favorBonus = getDemonFavor(entityCard.aspect as DemonTrait) * 0.1;
  const corruptionMod = getCorruptionModifier();
  const presenceBonus = getPresenceSummonBonus();
  
  let baseAdvantage = 0;
  if (entityCard.rarity === 'common') baseAdvantage = 2;
  else if (entityCard.rarity === 'uncommon') baseAdvantage = 0;
  else if (entityCard.rarity === 'rare') baseAdvantage = -2;
  else if (entityCard.rarity === 'epic') baseAdvantage = -4;
  else if (entityCard.rarity === 'legendary') baseAdvantage = -6;
  
  const advantage = baseAdvantage +
    (circleQuality.value * 6) +
    (selectedRunes.value.length * 1) +
    (bonuses.summonChance || 0) * 10 +
    (temporaryBuffs.value.summonBonus || 0) * 5 +
    favorBonus * 5 +
    (masteryLevel.value * 0.5) +
    (banishPower.value / 20) -
    (demonWrath.value / 40) +
    (corruptionMod * 10) +
    (circlePower.value / 20) +
    (presenceBonus * 100);
    
  return Math.floor(advantage);
}

// Rune bonuses (adapted from old system)
function getRuneBonuses(): { summonChance: number; dominationChance: number } {
  return {
    summonChance: selectedRunes.value.length * 0.02,
    dominationChance: 0
  };
}

export function summonEntity(): void {
  if (currentPhase.value.status !== 'idle') { console.warn('Cannot summon now – current phase:', currentPhase.value.status); return; }
  transition({ type: 'START_SUMMON', entityCardId: 'pending' });
  if (health.value <= 0) return;
  if (crafted.value.powderOfWarding <= 0) {
    addLog("Missing Powder of Warding.", true);
    return;
  }
  if (crafted.value.phialOfSubjugation <= 0) {
    addLog("Missing Phial of Subjugation.", true);
    return;
  }
  if (selectedRunes.value.length === 0) {
    addLog("No pattern selected! Select a pattern from the orbiting runes.", true);
    return;
  }
  if (circleQuality.value === 0) {
    addLog("The circle is untraced! Trace the circle first.", true);
    return;
  }

  // Determine entity to summon
  let tier: 1 | 2 | 3 = 1;
  let aspect = 'Void';
  
  const activePattern = selectedRunes.value[0];
  if (activePattern.includes('Fire')) aspect = 'Fire';
  else if (activePattern.includes('Earth')) aspect = 'Earth';
  else if (activePattern.includes('Air')) aspect = 'Air';
  else if (activePattern.includes('Water')) aspect = 'Water';
  else if (activePattern.includes('Life')) aspect = 'Life';
  else if (activePattern.includes('Death')) aspect = 'Death';
  
  if (circlePower.value > 70 && orbexFragments.value >= 3) {
    tier = 3;
  } else if (circlePower.value > 40 || orbexFragments.value >= 1) {
    tier = 2;
  }
  
  const entityCard = getRandomEntityCard(aspect, tier);
  if (!entityCard) {
    addLog("The void offers no response...", true);
    return;
  }

  batch(() => {
    crafted.value = {
      ...crafted.value,
      powderOfWarding: crafted.value.powderOfWarding - 1,
      phialOfSubjugation: crafted.value.phialOfSubjugation - 1
    };
  });

  const playerEntity = getActiveEntity();

  let activeEntity = playerEntity;
  if (!activeEntity) {
    activeEntity = {
      id: 'umbral_mite',
      name: 'Umbral Mite',
      type: 'entity',
      rarity: 'common',
      aspect: 'Void',
      image: '/Images/Game Art/Creatures/Umbral Mite.png',
      frame: '/Images/Game Art/Frame Overlays/Common Frame.png',
      stats: { hp: 5, atk: 2, spd: 3, cun: 2, def: 0, res: 10, init: 3, loyalty: 70 },
      abilities: [{ name: 'Void Syphon', type: 'combat', trigger: 'onDamage', effect: 'Heals 1 HP when dealing damage.' }]
    } as Card;
  }
  const finalPlayerEntity = activeEntity;

  const advantage = calculateSummonAdvantage(entityCard);

  const ritualCircle = el("ritualCircle");
  if (ritualCircle) {
    ritualCircle.classList.add("summon-animation");
    setTimeout(() => ritualCircle.classList.remove("summon-animation"), 600);
  }

  openCardBattleModal({
    enemyCard: entityCard,
    playerCard: finalPlayerEntity,
    advantage,
    onVictory: (choice: 'barter' | 'destroy' | 'ensnare') => {
      handleSummonVictory(entityCard, choice, tier);
    },
    onDefeat: () => {
      handleSummonDefeat(entityCard, tier);
    }
  });

  startLoop('demonSummonBg');
  playSfx('summonSuccess');
}

function handleSummonVictory(enemyCard: Card, choice: 'barter' | 'destroy' | 'ensnare', tier: number): void {
  stopLoop('demonSummonBg');
  
  batch(() => {
    totalSummons.value++;
    addFamiliarXP(5 + tier * 2);
    addMasteryXP(10 + tier * 3);
    kalgothsNoose.value = Math.max(0, kalgothsNoose.value - 5);
  });

  if (choice === 'ensnare') {
    addCard(enemyCard.id, 1);
    addLog(`🔮 ${enemyCard.name} has been bound to your Grimoire!`, false, 'player');
    playSfx('captureDemon');
    addLedgerEntry('summon', { entityName: enemyCard.name, aspect: enemyCard.aspect, ensnared: true });
    discover('demons', enemyCard.aspect as DemonTrait);
    
    const demon: Demon = {
      name: enemyCard.name,
      trait: enemyCard.aspect as DemonTrait,
      tier,
      image: enemyCard.image,
      resistance: 0.3 + (tier * 0.1),
      personality: { mood: 60, favor: 0, history: [] }
    };
    activeDemon.value = demon;
    activeDemonTier.value = tier;
    
  } else if (choice === 'barter') {
    const lootCard = getBarterReward(enemyCard);
    addCard(lootCard.id, 1);
    addLog(`${enemyCard.name} offers you ${lootCard.name} (${lootCard.rarity}) in exchange for freedom.`, false, 'player');
    
    ingredients.value = {
      ...ingredients.value,
      demonIchor: ingredients.value.demonIchor + 2 + tier
    };
    playSfx('bargainSecret');
    addLedgerEntry('bargain', { entityName: enemyCard.name, reward: lootCard.name, rarity: lootCard.rarity });
    
  } else if (choice === 'destroy') {
    const ichorGain = 3 + tier * 2;
    const boneGain = 2 + tier;
    ingredients.value = {
      ...ingredients.value,
      demonIchor: ingredients.value.demonIchor + ichorGain,
      boneDust: (ingredients.value.boneDust || 0) + boneGain
    };
    addLog(`${enemyCard.name} has been destroyed. +${ichorGain} Ichor, +${boneGain} Bone Dust.`, false, 'player');
    modifyDemonWrath(3);
    playSfx('destroyDemon');
    addLedgerEntry('destroy', { entityName: enemyCard.name, ichor: ichorGain, bone: boneGain });
  }

  // Emit event bus message (backward compatible)
gameBus.emit<SummonVictoryPayload>(GameEvents.SUMMON_VICTORY, {
  entityCard: enemyCard,
  choice,
  tier
});
  if (!tutorial.value.firstSummon) {
    tutorial.value = { ...tutorial.value, firstSummon: true };
    addLog('📖 Tome updated: Entity Summoning.', false, 'system');
  }
  
  reduceQuota();
  transition({ type: 'SUMMON_COMPLETE' });
  advanceAction();
  transition({ type: 'SUMMON_COMPLETE' });
  resetCircleAfterSummon();
  autoSave();
}

function handleSummonDefeat(enemyCard: Card, tier: number): void {
  stopLoop('demonSummonBg');
  
  batch(() => {
    health.value = Math.max(0, health.value - SUMMON_TIERS[tier].healthCost);
    will.value = Math.max(0, will.value - 10);
    kalgothsNoose.value = Math.min(100, kalgothsNoose.value + 10);
    demonWrath.value = Math.min(100, demonWrath.value + 5);
  });
  
  addLog(`💀 The summoning fails! ${enemyCard.name} overwhelms you.`, true);
  playSfx('summonFail');
  
  if (health.value <= 0) {
    addLog("You perish...", true);
    alert("Game Over");
    document.body.style.pointerEvents = "none";
  }
  
  advanceAction();
  transition({ type: 'SUMMON_COMPLETE' });
  resetCircleAfterSummon();
  autoSave();
}

