@echo off
setlocal enabledelayedexpansion

:: ============================================================
::  KALGOTH'S GAZE - Bulletproof Game Launcher
:: ============================================================

title Kalgoth's Gaze - Launcher
color 0A
echo.
echo   ========================================================
echo              KALGOTH'S GAZE - UNDERCRYPT
echo   ========================================================
echo.

:: ============================================================
::  1. Check for Node.js
:: ============================================================
echo [1/6] Checking for Node.js...
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [ERROR] Node.js is not installed or not in PATH.
    echo.
    echo Please install Node.js from https://nodejs.org/
    echo.
    pause
    exit /b 1
)

:: Get Node.js version
for /f "tokens=*" %%i in ('node -v') do set NODE_VERSION=%%i
echo       Node.js %NODE_VERSION% detected.

:: ============================================================
::  2. Check for npm
:: ============================================================
echo [2/6] Checking for npm...
where npm >nul 2>nul
if %errorlevel% neq 0 (
    echo [ERROR] npm is not available.
    pause
    exit /b 1
)
for /f "tokens=*" %%i in ('npm -v') do set NPM_VERSION=%%i
echo       npm %NPM_VERSION% detected.

:: ============================================================
::  3. Navigate to script directory
:: ============================================================
cd /d "%~dp0"
echo [3/6] Working directory: %cd%

:: ============================================================
::  4. Check/Install dependencies
:: ============================================================
echo [4/6] Checking dependencies...
if not exist "node_modules" (
    echo       node_modules not found. Running npm install...
    call npm install
    if !errorlevel! neq 0 (
        echo [ERROR] npm install failed.
        pause
        exit /b 1
    )
    echo       Dependencies installed successfully.
) else (
    echo       node_modules exists.
    :: Quick check for critical modules
    if not exist "node_modules\vite" (
        echo       Vite missing. Running npm install...
        call npm install
        if !errorlevel! neq 0 (
            echo [ERROR] npm install failed.
            pause
            exit /b 1
        )
    )
)

:: ============================================================
::  5. Clear Vite cache (prevents stale module errors)
:: ============================================================
echo [5/6] Clearing Vite cache...
if exist "node_modules\.vite" (
    rmdir /s /q "node_modules\.vite" 2>nul
    echo       Vite cache cleared.
) else (
    echo       No Vite cache found.
)

:: Also clear any temp Vite files in the project
if exist ".vite" (
    rmdir /s /q ".vite" 2>nul
)

:: ============================================================
::  6. Kill any process using port 3000
:: ============================================================
echo [6/6] Checking port 3000...
set PORT=3000
set PID=
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :%PORT% ^| findstr LISTENING') do (
    set PID=%%a
    goto :foundPID
)
goto :noPID

:foundPID
echo       Port %PORT% is in use by PID !PID!. Attempting to free...
taskkill /F /PID !PID! >nul 2>nul
if !errorlevel! equ 0 (
    echo       Successfully freed port %PORT%.
    timeout /t 2 /nobreak >nul
) else (
    echo       [WARNING] Could not free port %PORT%. The server may fail to start.
)
goto :startServer

:noPID
echo       Port %PORT% is free.

:startServer
echo.
echo   ========================================================
echo                     STARTING GAME SERVER
echo   ========================================================
echo.

:: ============================================================
::  Start Vite dev server
:: ============================================================
echo Starting Vite development server...
echo.
echo The game will open in your browser shortly.
echo Press Ctrl+C in this window to stop the server.
echo.

:: Launch Vite with forced cache clear and auto-open
start "" http://localhost:3000
call npx vite --force --host --open

:: If Vite fails, pause to show error
if %errorlevel% neq 0 (
    echo.
    echo [ERROR] Vite server failed to start.
    echo.
    echo Troubleshooting:
    echo   1. Delete node_modules and run npm install manually.
    echo   2. Check that port 3000 is not blocked by firewall.
    echo   3. Run 'npx vite' directly to see detailed error.
    echo.
    pause
    exit /b 1
)

endlocal